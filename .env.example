# Copy to .env and fill in. Plain KEY=VALUE, no quotes.
# Read automatically by `docker compose`; Jenkins loads it from the `calculator-env` credential.
# Docker Hub login is NOT stored here; it lives in the Jenkins credential `dockerhub-credentials`.

# Docker Hub repository the pipeline pushes to and Compose runs
DOCKER_IMAGE=your-dockerhub-username/spe-calculator

# Host port Nginx publishes the API on (8080 is taken by Jenkins)
HOST_PORT=8081

# Where Jenkins sends build status emails
NOTIFY_EMAIL=your-email@example.com
